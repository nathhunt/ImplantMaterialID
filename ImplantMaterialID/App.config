<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <!--
    ESAPI's own dependency chain often needs binding redirects (e.g. for
    Newtonsoft.Json or other shared assemblies pulled in by
    VMS.TPS.Common.Model.API). If you see a FileLoadException or
    "could not load file or assembly" error at runtime referencing a
    specific assembly + version, add a <dependentAssembly> entry for it
    here. Visual Studio will usually offer to auto-generate these for you
    the first time you build against the real ESAPI DLLs.
  -->
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <!-- Example - uncomment and adjust versions to match what your ESAPI install requires:
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
      -->
    </assemblyBinding>
  </runtime>
</configuration>
