<Window x:Class="ImplantMaterialID.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Implant Material Identifier" Height="640" Width="560"
        MinHeight="560" MinWidth="480">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Implant Material Identifier" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="Estimates whether a contoured metal implant is stainless steel or titanium, from its mean HU, diameter and scan FOV."
                       TextWrapping="Wrap" Foreground="#555" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Patient ID -->
        <Grid Grid.Row="1" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="Patient ID"/>
            <TextBox Grid.Column="1" Text="{Binding PatientId, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Grid.Column="2" Content="Load Patient" Command="{Binding LoadPatientCommand}" Margin="8,4,0,4"/>
        </Grid>

        <!-- Structure set -->
        <Grid Grid.Row="2" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="Structure set"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding StructureSets}"
                      SelectedItem="{Binding SelectedStructureSet}"
                      DisplayMemberPath="Description"/>
        </Grid>

        <!-- Structure -->
        <Grid Grid.Row="3" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="Implant structure"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding Structures}"
                      SelectedItem="{Binding SelectedStructure}"
                      DisplayMemberPath="Id"/>
        </Grid>

        <!-- Diameter -->
        <Grid Grid.Row="4" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="Implant diameter (mm)"/>
            <TextBox Grid.Column="1" Text="{Binding DiameterMmText, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>

        <!-- Calculate -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,4,0,8">
            <Button Content="Calculate" Command="{Binding CalculateCommand}"/>
        </StackPanel>

        <!-- Busy indicator -->
        <ProgressBar Grid.Row="6" Height="4" IsIndeterminate="True"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                     Margin="0,0,0,8"/>

        <!-- Results -->
        <Border Grid.Row="7" BorderBrush="#CCC" BorderThickness="1" Padding="12" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Results" FontWeight="Bold" Margin="0,0,0,8"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Measured mean HU:"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding MeanHu, StringFormat={}{0:0}}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Scan FOV (mm):"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FovMm, StringFormat={}{0:0}}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Expected HU - stainless steel:"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Result.ExpectedStainlessSteelHu, StringFormat={}{0:0}}"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Expected HU - titanium:"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Result.ExpectedTitaniumHu, StringFormat={}{0:0}}"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Difference (SS / Ti):"/>
                    <TextBlock Grid.Row="4" Grid.Column="1">
                        <Run Text="{Binding Result.DifferenceFromStainlessSteel, StringFormat={}{0:0}}"/>
                        <Run Text=" / "/>
                        <Run Text="{Binding Result.DifferenceFromTitanium, StringFormat={}{0:0}}"/>
                        <Run Text=" HU"/>
                    </TextBlock>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Likely material:" FontWeight="Bold"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Result.Summary}" FontWeight="Bold" TextWrapping="Wrap"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding Result.Warnings}" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#B00020" Margin="0,2,0,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Status bar -->
        <TextBlock Grid.Row="8" Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="#333"/>
    </Grid>
</Window>
